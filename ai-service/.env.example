# Example only — copy to ai-service/.env and replace placeholders.
#   cp .env.example .env

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Windows: set full path after installing Tesseract
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# Windows/local: use 1 to avoid EasyOCR instability
# Render/Linux Docker uses Tesseract + RapidOCR from requirements.txt
SKIP_EASYOCR=1

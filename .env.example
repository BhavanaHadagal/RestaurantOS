# Example only — copy to backend/.env and replace every placeholder.
#   cp .env.example backend/.env
#
# AI service: copy ai-service/.env.example → ai-service/.env
# Docker Compose (optional root .env): set GEMINI_API_KEY and JWT_* there.

# --- Backend (backend/.env) ---

# Database
# Local PostgreSQL: port 5432
# Docker Compose postgres: port 5433 (host) — see docker-compose.yml
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DATABASE

# JWT (use long random strings in production)
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# App
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

AI_SERVICE_URL=http://127.0.0.1:8000
# Render production (auto-detected when RENDER=true if unset):
# AI_SERVICE_URL=https://restaurantos-ai.onrender.com

# Email (for password reset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# --- Docker Compose (optional root .env) ---
# GEMINI_API_KEY=
